Describe lsp#uivim#completion

    Before each
        %delete _
        setlocal filetype=html
        setlocal omnifunc=lsp#omni#complete
    End

    It should accept a multiline snippet without tabstops or textEdit
        if !has('nvim')
            Skip This headless completion test requires Neovim
        endif
        let l:script = tempname()
        let l:result = tempname()
        let l:root = getcwd()
        call writefile([
            \ 'let $COMPLETION_RESULT = ' . string(l:result),
            \ 'source ' . fnameescape(l:root . '/test/testfiles/completion_multiline_snippet.vim'),
            \ ], l:script)
        try
            call system(shellescape(v:progpath) . ' --headless -u NONE -i NONE -n -S ' . shellescape(l:script))
            Assert Equals(v:shell_error, 0)
            Assert Equals(readfile(l:result), [])
        finally
            call delete(l:script)
            call delete(l:result)
        endtry
    End

    It should expand simple snippet with multibyte chars
        Skip This test needs asynchronous process and snippetSupport=true

        call setline(1, ['<div class="あいうえお">'])
        execute "normal! 'gg$ha id\<C-x>\<C-o>\<C-n>\<Tab>'"

        " wait for feedkeys.

        Assert Equals(getline(1), '<div class="あいうえお" id="">')
        Assert Equals(getpos('.')[1 : 2], [1, 30])
    End

    It should expand when textEdit.start.character is less than completion start col
        Skip This test needs asynchronous process and snippetSupport=true

        call setline(1, [
              \ '<html>',
              \ '  <div>',
              \ '    </>',
              \ '</html>'])
        execute "normal! ':gg2j$ha\<C-x>\<C-o>\<C-n>\<Tab>'"

        " wait for feedkeys.

        Assert Equals(getline(3), '  </div>')
        Assert Equals(getpos('.')[1 : 2], [1, 8])
    End

End
